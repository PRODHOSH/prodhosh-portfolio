# Copy to .env.local for local dev. On Netlify set these under Site configuration -> Environment variables.
OPENROUTER_API_KEY=
# Gmail address that sends (and, by default, receives) the chat transcripts
EMAIL_USER=
# Google App Password (Google Account -> Security -> 2-Step Verification -> App passwords), NOT your normal password
EMAIL_PASS=
# Optional: send transcripts to a different inbox
CHAT_LOG_TO=
